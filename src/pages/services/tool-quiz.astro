---
// ============================================================
// /services/tool-quiz/ — 子網域曝露成 /quiz/（見 worker/domain-router.mjs）。
// 只放測驗本身：讓主站的入口跳轉到這裡完成問答與後續聯絡。
// resources.astro 限定的 Step1/Step2/FAQ 內容不搬過來，
// 子網域訪客直接要答案，不需要主站的完整免費資源清單。
// ============================================================
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolQuiz from '../../components/ToolQuiz.astro';
import { SERVICE_SITE, breadcrumbSchema } from '../../consts';
import ServiceBase from '../../layouts/ServiceBase.astro';

const schema = [
  breadcrumbSchema([
    { name: '服務首頁', item: `${SERVICE_SITE.url}/` },
    { name: '工具選擇測驗' },
  ]),
];
---

<ServiceBase
  title="工具選擇測驗｜30 秒找到合適的 AI 工具"
  description="無論想做自動發文、社群圖文、剪輯或配音，第一步都先安裝 Codex；回答 3 題，再依每個需求告訴你要搭配什麼工具。"
  schema={schema}
  canonicalPath="/quiz/"
>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumbs items={[{ name: '服務首頁', href: `${SERVICE_SITE.url}/` }, { name: '工具選擇測驗' }]} />
    <ToolQuiz />
  </div>
</ServiceBase>
